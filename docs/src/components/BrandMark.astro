---
const base = import.meta.env.BASE_URL;
---

<div class="brand-mark" aria-hidden="true">
  <img src={`${base}rune.png`} alt="" />
</div>

<style>
  .brand-mark {
    display: flex;
    justify-content: center;
    margin: 0.5rem auto 0.9rem;
  }

  .brand-mark img {
    width: clamp(5rem, 14vw, 7.5rem);
    height: auto;
    filter:
      drop-shadow(0 0 0.8rem rgba(222, 175, 70, 0.22))
      drop-shadow(0 0 2rem rgba(248, 232, 185, 0.08));
  }
</style>
