---
const clientId =
  import.meta.env.PUBLIC_RUNE_DISCORD_CLIENT_ID ??
  '1541130190392918126';

const invite =
  `https://discord.com/oauth2/authorize?client_id=${encodeURIComponent(clientId)}&scope=bot%20applications.commands`;
---

<div class="install">
  <a
    class="install-button"
    href={invite}
    title="Add Rune to a Discord server"
  >
    Add to server
  </a>
</div>

<style>
  .install {
    display: flex;
    justify-content: center;
    margin: 0.8rem auto 2.2rem;
  }

  .install-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    min-width: 10.5rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.65rem;
    font-weight: 650;
    text-decoration: none;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
  }

  @media (max-width: 34rem) {
    .install-button {
      width: min(100%, 20rem);
    }
  }
</style>
