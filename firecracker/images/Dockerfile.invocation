ARG BASE_IMAGE=debian:bookworm-slim
FROM rust:1-bookworm AS guest-builder
WORKDIR /build
COPY native/Rune.Firecracker.Guest/Cargo.toml Cargo.toml
COPY native/Rune.Firecracker.Guest/src src
RUN cargo build --release

FROM ${BASE_IMAGE}
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgcc-s1 libstdc++6 libunwind8 zlib1g \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /proc /dev /tmp
COPY --from=guest-builder /build/target/release/rune-firecracker-guest /sbin/rune-guest
