ARG BASE_IMAGE=debian:bookworm-slim
FROM rust:1-bookworm AS guest-builder
WORKDIR /build
COPY native/Rune.Firecracker.Guest/Cargo.toml Cargo.toml
COPY native/Rune.Firecracker.Guest/src src
RUN cargo build --release

FROM ${BASE_IMAGE}
ARG RUNTIME
RUN apt-get update && case "$RUNTIME" in \
      native) apt-get install -y --no-install-recommends libgcc-s1 libstdc++6 ;; \
      python|ruby) true ;; \
      *) exit 2 ;; \
    esac && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /proc /dev /tmp && printf '%s\n' "$RUNTIME" > /etc/rune-runtime
COPY --from=guest-builder /build/target/release/rune-firecracker-guest /sbin/rune-guest
