<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Rune.Core\Rune.Core.csproj" />
    <ProjectReference Include="..\Rune.Runtime\Rune.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="NetCord" Version="1.0.0-beta.16" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-beta.16" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-beta.16" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-beta.16" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NativeRuntimeManifest>$(MSBuildThisFileDirectory)../../native/Rune.Runtime.Native/Cargo.toml</NativeRuntimeManifest>
    <NativeRuntimeOutput>$(MSBuildThisFileDirectory)../../target/release</NativeRuntimeOutput>
    <NativeRuntimeLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">librune_runtime.so</NativeRuntimeLibrary>
    <NativeRuntimeLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">librune_runtime.dylib</NativeRuntimeLibrary>
    <NativeRuntimeLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">rune_runtime.dll</NativeRuntimeLibrary>
  </PropertyGroup>

  <Target Name="BuildRuneNativeRuntime" AfterTargets="Build">
    <Exec Command="cargo build --manifest-path &quot;$(NativeRuntimeManifest)&quot; --release" />
    <Copy SourceFiles="$(NativeRuntimeOutput)/$(NativeRuntimeLibrary)" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
