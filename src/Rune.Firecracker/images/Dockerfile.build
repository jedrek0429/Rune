ARG BASE_IMAGE=debian:bookworm-slim

FROM rust:1-bookworm AS guest-builder
WORKDIR /build
COPY src/Rune.Firecracker.BuildGuest/Cargo.toml Cargo.toml
COPY src/Rune.Firecracker.BuildGuest/src src
RUN cargo build --release

FROM ${BASE_IMAGE}

ARG POOL
ARG NODE_VERSION=24.15.0
ARG SCRIPTC_VERSION=0.0.35
ARG ZIG_VERSION=0.16.0
ARG MICROPYTHON_VERSION=v1.29.0

COPY src/Rune.Firecracker/build-tools/python.sh /usr/local/bin/rune-build-python
COPY src/Rune.Firecracker/build-tools/rust.sh /usr/local/bin/rune-build-rust
COPY src/Rune.Firecracker/build-tools/build-python-runtime.sh /usr/local/bin/build-python-runtime
COPY src/Rune.Firecracker/python/rune_port.c /opt/rune/python/rune_port.c
COPY src/Rune.Firecracker/python/rune_time.h /opt/rune/python/rune_time.h
COPY src/Rune.Firecracker/python/mpconfigrune.h /opt/rune/python/mpconfigrune.h
RUN chmod 0755 \
    /usr/local/bin/rune-build-python \
    /usr/local/bin/rune-build-rust \
    /usr/local/bin/build-python-runtime

RUN case "$POOL" in \
      clang) \
        apt-get update && \
        apt-get install -y --no-install-recommends clang g++ && \
        rm -rf /var/lib/apt/lists/* \
        ;; \
      rust) \
        mkdir -p /opt/rune/rust && \
        printf '[package]\nname = "rune-program"\nversion = "0.1.0"\nedition = "2024"\n\n[dependencies]\nserde = { version = "1", features = ["derive"] }\nserde_json = "1"\nserde_repr = "0.1"\n' \
            > /opt/rune/rust/Cargo.toml && \
        mkdir -p /opt/rune/rust/src && \
        printf 'fn main() {}\n' > /opt/rune/rust/src/main.rs && \
        cargo fetch --manifest-path /opt/rune/rust/Cargo.toml && \
        ln -sf /usr/local/cargo/bin/cargo /usr/local/bin/cargo && \
        printf '#!/bin/sh\nRUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo exec /usr/local/cargo/bin/rustc "$@"\n' \
            > /usr/local/bin/rustc && \
        chmod 0755 /usr/local/bin/rustc \
        ;; \
      scriptc) \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            ca-certificates \
            curl \
            xz-utils && \
        case "$(dpkg --print-architecture)" in \
          amd64) node_arch=x64; zig_arch=x86_64 ;; \
          arm64) node_arch=arm64; zig_arch=aarch64 ;; \
          *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 2 ;; \
        esac && \
        curl -fsSL -o /tmp/node.tar.xz \
            "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" && \
        tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 && \
        curl -fsSL -o /tmp/zig.tar.xz \
            "https://ziglang.org/download/${ZIG_VERSION}/zig-${zig_arch}-linux-${ZIG_VERSION}.tar.xz" && \
        mkdir -p /opt/zig && \
        tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 && \
        ln -s /opt/zig/zig /usr/local/bin/zig && \
        npm install -g --allow-scripts=scriptc "scriptc@${SCRIPTC_VERSION}" && \
        rm -rf /var/lib/apt/lists/* /tmp/node.tar.xz /tmp/zig.tar.xz \
        ;; \
      python) \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            build-essential \
            ca-certificates \
            git \
            python3 && \
        MICROPYTHON_VERSION="${MICROPYTHON_VERSION}" \
            /usr/local/bin/build-python-runtime && \
        rm -rf /var/lib/apt/lists/* \
        ;; \
      *) \
        echo "unsupported build pool: $POOL" >&2; \
        exit 2 \
        ;; \
    esac

RUN mkdir -p /proc /dev /work /input

COPY --from=guest-builder \
    /build/target/release/rune-firecracker-build-guest \
    /sbin/rune-build-guest
